UNIFY_API_BASE_URL=https://voskuils.com
# Server-only. Scopes: payments:create, payments:read, payments:cancel, refunds:create (reissue the key to add refunds).
UNIFY_VENDOR_API_KEY=
UNIFY_BRANCH_ID=
# Separate payment callback secret, shown once in the owner integration screen. Server-only.
UNIFY_PAYMENT_WEBHOOK_SECRET=
POS_ORIGIN=https://your-pos-demo.vercel.app
POS_OPERATOR_PASSWORD=
POS_SESSION_SECRET=
# Vercel production login requires a distributed limiter. These store counters only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set only after deploying a Vercel firewall rule: POST /api/operator, 5 requests per IP per 900s.
POS_LOGIN_FIREWALL_ENABLED=false
